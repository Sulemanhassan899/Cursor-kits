{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obecno.local/qa/catalog/scenarios.schema.json",
  "title": "Obecno QA Scenario Catalog",
  "description": "Merged scenario catalog for QA agent runs (Sheet6-compatible).",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "role",
      "module",
      "screen",
      "functionality",
      "online",
      "offline",
      "layer",
      "tags",
      "steps",
      "expected"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z]{2,5}-[A-Z0-9]+-[0-9]{3}$",
        "description": "Unique scenario id, e.g. EMP-SPLASH-001"
      },
      "role": {
        "type": "string",
        "enum": [
          "employee",
          "manager",
          "shared",
          "cross"
        ]
      },
      "module": {
        "type": "string",
        "minLength": 1
      },
      "screen": {
        "type": "string",
        "minLength": 1
      },
      "functionality": {
        "type": "string",
        "minLength": 1
      },
      "online": {
        "type": "boolean"
      },
      "offline": {
        "type": "boolean"
      },
      "layer": {
        "type": "string",
        "enum": [
          "A",
          "B",
          "C",
          "D"
        ],
        "description": "A=module-alone, B=full journey, C=cross-role, D=quality"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "expected": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
