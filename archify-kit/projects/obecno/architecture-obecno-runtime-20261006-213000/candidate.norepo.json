  "cards": [
    {
      "dot": "cyan",
      "title": "Primary journey",
      "items": [
        "User opens Obecno → GoRouter picks employee or manager shell",
        "AppBindings resolves repositories and ApiClient for that session",
        "Attendance and manager data flow over HTTPS to the Obecno API"
      ]
    },
    {
      "dot": "emerald",
      "title": "Offline & location",
      "items": [
        "Punches can queue in SQLite when connectivity is poor",
        "SyncService retries uploads when the network returns",
        "Location services and native alarms support reminders outside the UI"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Tokens attach inside ApiClient before calls leave the device",
        "Join invite links enter through AppLinks, not the REST API",
        "Backend authority lives off-device; the app is a smart client"
      ]
    }
  ]
